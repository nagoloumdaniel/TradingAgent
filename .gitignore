# Secrets: only the template is versioned
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Local data: market history and databases are never versioned.
# Anchored to the root: an unanchored "data/" also hid the src/tradingagent/data package.
/data/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Backups: `scripts/backup.ps1` writes here by default. Encrypted or not, a dump is a
# copy of the database and has no business in the repository — a plain `git add -A`
# after a backup would have committed it.
/backups/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Assistant plugin workspace state (scan ledgers, session baselines) is local only.
.mimosa/
.v2c/
.video_agent/
