# Copy to .env and fill in. Never commit .env.
# One file per environment: live credentials must never appear in the demo file.

# Deriv MetaTrader 5 (C-010: the Deriv API is not available to French residents)
MT5_LOGIN=
MT5_SERVER=
# INVESTOR (read-only) password until execution starts in phase 8. Never the Deriv client-area password.
MT5_PASSWORD=
# Optional: path to terminal64.exe when several MT5 terminals are installed
MT5_TERMINAL_PATH=

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to send commands
TELEGRAM_ALLOWED_USER_IDS=

# Claude API (signal explanation and reports, see CAHIER_DES_CHARGES.md F-010)
# OPTIONAL: without it the AI filter is simply not wired, and the deterministic rules
# decide alone (RM-011). Never let a missing model key stop the agent.
ANTHROPIC_API_KEY=

# Storage - hosted PostgreSQL (Supabase, Session pooler URI), required: no local fallback.
DATABASE_URL=

# Startup mode: OBSERVATION | SIGNAL | PAPER | DEMO. LIVE cannot be set here alone (RM-000).
TRADING_MODE=SIGNAL
# Server-side half of the LIVE double condition (RM-000). Keep false outside phase 9.
LIVE_TRADING_ENABLED=false
