# Copy to .env and fill in. Never commit .env.
# One file per environment: live credentials must never appear in the demo file.

# Deriv MetaTrader 5 (C-010: the Deriv API is not available to French residents)
MT5_LOGIN=
MT5_SERVER=
# INVESTOR (read-only) password until execution starts in phase 8. Never the Deriv client-area password.
MT5_PASSWORD=
# Optional: path to terminal64.exe when several MT5 terminals are installed
MT5_TERMINAL_PATH=
# Optional: the MQL5 Guardian EAs' file directory. This is NOT under MT5_TERMINAL_PATH:
# it is <MT5 data folder>\MQL5\Files\TradingAgent, typically
# %APPDATA%\MetaQuotes\Terminal\<instance hash>\MQL5\Files\TradingAgent.
# Leave empty when no EA is installed.
EA_FILES_DIR=

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to send commands
TELEGRAM_ALLOWED_USER_IDS=

# Claude API (signal explanation and reports, see CAHIER_DES_CHARGES.md F-010)
# OPTIONAL: without it the AI filter is simply not wired, the AI Lab keeps its
# deterministic verdicts, and the rules decide alone (RM-011). Never let a missing model
# key stop the agent.
# Where: console.anthropic.com -> Settings -> API Keys -> Create Key
ANTHROPIC_API_KEY=

# Storage - hosted PostgreSQL (Supabase, Session pooler URI), required: no local fallback.
# Where: Supabase -> Project Settings -> Database -> Connection string -> Session pooler
DATABASE_URL=

# Storage for the PostgreSQL-specific tests (row-level security, append-only triggers,
# concurrency). OPTIONAL: without it those tests are skipped and the suite runs on SQLite.
# Where: a SECOND Supabase project (or database) whose name ENDS IN `_test`.
# WARNING: these tests drop every table. Never point this at the agent's database.
TEST_DATABASE_URL=

# Startup mode: OBSERVATION | SIGNAL | PAPER | DEMO. LIVE cannot be set here alone (RM-000).
TRADING_MODE=SIGNAL
# Server-side half of the LIVE double condition (RM-000). Keep false outside phase 9.
LIVE_TRADING_ENABLED=false

# ---------------------------------------------------------------------------------------
# Secrets you generate yourself. Neither is needed to run the agent; both are needed to
# operate it safely. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------------------

# Encrypts the backups. Keep it OUT of the server: without it, no backup is recoverable.
# Used by scripts/backup.ps1 and scripts/restore.ps1.
BACKUP_PASSPHRASE=

# Optional access protection for the dashboard (cahier v3 §43). Empty or absent leaves the
# dashboard exactly as it was: local, read-only, unauthenticated. 16 characters minimum.
# Required as soon as the page leaves 127.0.0.1, behind a reverse proxy that terminates TLS.
TRADINGAGENT_WEB_TOKEN=
