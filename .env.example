# Copy to .env and fill in. Never commit .env.
# One file per environment: the live token must never appear in the demo file.

# Deriv - application id from the developer portal, distinct from the trading account
DERIV_APP_ID=
# Deriv - API token with scopes "read" and "trade" ONLY. Never "payments" nor "admin".
DERIV_API_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to send commands
TELEGRAM_ALLOWED_USER_IDS=

# Claude API (signal explanation and reports, see CAHIER_DES_CHARGES.md F-010)
ANTHROPIC_API_KEY=

# Storage - SQLite until phase 8, PostgreSQL afterwards (C-005)
DATABASE_URL=sqlite:///./data/tradingagent.db

# Startup mode: OBSERVATION | SIGNAL | PAPER | DEMO. LIVE cannot be set here alone (RM-000).
TRADING_MODE=SIGNAL
# Server-side half of the LIVE double condition (RM-000). Keep false outside phase 9.
LIVE_TRADING_ENABLED=false
